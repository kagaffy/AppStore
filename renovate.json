{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "before 10am on monday"
  ],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Group Mint CLI tools",
      "matchManagers": [
        "mint"
      ],
      "groupName": "mint-cli"
    },
    {
      "description": "Group GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Group Swift Package Manager deps",
      "matchManagers": [
        "swift"
      ],
      "groupName": "spm"
    }
  ]
}
